              }
            ]
          }
        },
        "experience": [
          {
            "condition": "melee",
            "expression": "max(damage * 0.6, 1)"
          }
        ],
        "anti_farming_per_entity": {
          "limit_per_entity": 40,
          "reset_after_seconds": 300
        }
      }
    }
  ]
}
