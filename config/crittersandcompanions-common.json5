			{ biome_spec: "#fotf:wildlife/plains", weight: 5, min: 1, max: 3 },
			{ biome_spec: "minecraft:lush_caves", weight: 10, min: 1, max: 2 }
		]
	},
	necklace: { swim_speed: 0.2, drowned_range_debuff: 0.1, guardian_range_debuff: 0.1 },
	grapplingHook: { launch_speed: 1.0, max_speed: 2.0, max_distance: 32.0, enable_durability: true }
}
