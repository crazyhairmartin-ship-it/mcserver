    {
      "id": "prologue_letter",
      "title": "Word to the Neighbours",
      "after": [
        "prologue_dungeon"
      ],
      "text": [
        "Sister Wren writes to the cleric of the next village along the road. Deliver her letter in person; his reply will follow you home by post."
      ],
      "tasks": [
        {
          "talk": "villager",
          "profession": "minecraft:cleric",
          "lines": [
            "A letter from Sister Wren? It's been too long.",
            "Tell her I'll write back. The post's slow, but it gets there."
          ],
          "title": "Deliver the letter to another village's cleric"
        }
      ],
      "rewards": [
