    {
      "id": "act1_wrought_practice",
      "title": "Strike From Behind",
      "after": [
        "act1_temple",
        "act1_mineshaft"
      ],
      "text": [
        "Armour that breathes, in a sealed chamber. Captain Hale of the Village watch knows what that means, and wants you ready before you go anywhere near it."
      ],
      "tasks": [
        {
          "talk": "character",
          "character": "hale",
          "lines": [
            "Armour that breathes. I've seen it once. Lost good people that day.",
            "Iron giants are slow to turn. Get behind it and strike.",
            "Build yourself a target dummy and practise until it's habit.",
            "Then go and look. Look. Don't fight it until you're ready.",
            "...And come back. That's an order. People here would miss you."
          ]
        },
        {
          "item": "dummmmmmy:target_dummy"
        }
      ],
      "rewards": [
        {
          "skill": "defense",
          "xp": 80
        }
      ],
      "icon": "dummmmmmy:target_dummy"
