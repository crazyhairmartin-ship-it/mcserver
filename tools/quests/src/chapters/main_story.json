  "quests": [
    {
      "id": "prologue_silent_wood",
      "title": "The Silent Wood",
      "after": [
        "start:clerics_worry"
      ],
      "text": [
        "Sister Wren wants to know what's wrong with the forest. Go to the forest's edge after dusk and wait out one night.",
        "No fairies dance. The butterflies are gone. And something has scored the bark of the oldest tree."
      ],
      "tasks": [
        {
          "biome": "minecraft:forest",
          "title": "Go to the forest"
        },
        {
          "checkmark": "I waited out the night"
        }
      ],
      "rewards": [
        {
          "command": "/give {p} minecraft:potion{Potion:\"minecraft:night_vision\"}",
          "title": "A night vision potion"
        }
      ],
      "icon": "minecraft:oak_sapling"
    },
    {
