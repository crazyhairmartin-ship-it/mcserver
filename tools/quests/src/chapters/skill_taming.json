    {
      "id": "cat_colony",
      "title": "The Cats of the Ruin",
      "after": [
        "fox_kits"
      ],
      "text": [
        "A colony of stray cats lives in a crumbling ruin that creepers have overrun. Clear the creepers, coax every cat out with fish, and the old cat-lady of the ruin will leave you her slippers."
      ],
      "tasks": [
        {
          "structure": "#ruins",
          "title": "Find the overrun ruin"
        },
        {
          "kill": "minecraft:creeper",
          "count": 5,
          "title": "Clear the creepers away from the cats",
          "spawn": {
            "at": {
              "structure": "#ruins"
            }
          }
        },
        {
          "item": "minecraft:cod",
          "count": 4,
          "consume": true,
          "title": "Coax the cats out with fish"
        },
        {
          "encounter": {
            "entity": "minecraft:villager",
            "name": "The Cat-Lady of the Ruin",
            "then": "talk",
            "lines": [
              "My darlings, all safe! Forty winters among these ruins.",
              "Take my slippers, dear. The cats insist."
            ]
          }
        }
      ],
      "rewards": [
        {
          "item": "artifacts:kitty_slippers"
        },
        {
          "skill": "taming",
          "xp": 250
        }
      ],
      "icon": "artifacts:kitty_slippers",
      "signature": "artifacts:kitty_slippers"
    },
