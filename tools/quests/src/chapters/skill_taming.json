{
  "title": "The Sanctuary",
  "subtitle": "Taming path",
  "icon": "minecraft:bone",
  "group": "skills",
  "order": 11,
  "quests": [
    {
      "id": "stray_wolf",
      "title": "The Stray",
      "text": [
        "A shepherd says a half-starved wolf follows the flock at a distance. Tame it, give it a collar tag and bring it to Fern's pen at the edge of Reece."
      ],
      "tasks": [
        {
          "tame": "minecraft:wolf",
          "title": "Tame the wolf"
        },
        {
          "item": "domesticationinnovation:collar_tag"
        },
        {
          "place": "reece"
        },
        {
          "talk": "character",
          "character": "fern",
          "lines": [
            "Thin as a rake. Come in. You waited, most people shout.",
            "There's more to do here, if you'd help."
          ]
        }
      ],
      "rewards": [
        {
          "item": "minecraft:bone",
          "count": 16
        },
        {
          "skill": "taming",
          "xp": 50
        }
      ],
      "icon": "minecraft:bone",
      "giver": {
        "type": "org",
        "org": "sanctuary",
        "lines": [
          "A half-starved wolf follows my flock at a distance.",
          "Win its trust, and Keeper Fern in Reece will take it in."
        ],
        "accept": "I'll try"
      }
    },
    {
      "id": "first_pens",
      "title": "Pens and Pet Beds",
      "after": [
        "stray_wolf"
      ],
      "text": [
        "The sanctuary is a single fence. Build proper pens and pet beds so rescued animals have a place to rest."
      ],
      "tasks": [
        {
          "place": "reece"
        },
        {
          "item": "domesticationinnovation:pet_bed_brown",
          "crafted": true
        },
        {
          "build": {
            "blocks": {
              "#minecraft:fences": 12,
              "#minecraft:fence_gates": 1,
              "minecraft:hay_block": 2
            },
            "radius": 10
          },
          "title": "Build a pen"
        }
      ],
      "rewards": [
        {
          "item": "domesticationinnovation:pet_bed_blue"
        },
        {
          "item": "domesticationinnovation:pet_bed_red"
        },
        {
          "skill": "taming",
          "xp": 90
        }
      ],
      "icon": "domesticationinnovation:pet_bed_brown"
    },
    {
