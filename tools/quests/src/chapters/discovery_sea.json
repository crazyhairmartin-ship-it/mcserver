      ],
      "tasks": [
        {
          "be": {
            "in_water": true,
            "below_y": 45
          },
          "title": "Dive down to the skeleton's skull"
        },
        {
          "mine": "minecraft:bone_block",
          "count": 2,
          "title": "Break bone from the skeleton as proof"
        }
      ],
      "rewards": [
        {
          "item": "minecraft:bone_block",
          "count": 8
        },
        {
          "item": "minecraft:nautilus_shell"
