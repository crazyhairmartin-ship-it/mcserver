    {
      "id": "apprentice_papers",
      "title": "Apprentice Papers",
      "text": [
        "The guild's workshop in Reece is an empty barn. Show you can join wood by making a table and two chairs for the bare hall."
      ],
      "tasks": [
        {
          "item": "handcrafted:oak_table",
          "crafted": true
        },
        {
          "item": "handcrafted:oak_chair",
          "count": 2,
          "crafted": true
        },
        {
          "talk": "character",
          "character": "odile",
          "lines": [
            "A table and two chairs. Hmm. Turn them over.",
            "Rule Nine of the guild: a joint you can't see still has to be true.",
            "...They'll do. More than do. Welcome to the guild, apprentice.",
            "Olsen would have used more nails. Don't tell him I said that."
          ]
        }
      ],
      "rewards": [
        {
          "item": "handcrafted:hammer"
        },
        {
          "item": "minecraft:oak_planks",
          "count": 64
        },
        {
          "skill": "craft",
          "xp": 60
        }
      ],
      "icon": "handcrafted:oak_table",
      "giver": {
        "type": "org",
        "org": "crafters",
        "lines": [
          "The guild workshop in Reece is an empty barn, and Master Joiner Brask needs hands.",
          "Make a table and two chairs to show you can join wood, and she'll sign you on."
        ],
        "accept": "I'll sign on"
      }
    },
