      "text": [
        "A cartographer has pinned a Couriers' notice: runners wanted. Sign on at the Reece post office and carry your first signed letter to a cartographer in another village."
      ],
      "tasks": [
        {
          "talk": "character",
          "character": "juniper",
          "lines": [
            "New runner? Name, signature, go. We take what the carriers won't.",
            "Sign this letter. Take it to the next village's cartographer. Don't dawdle."
          ]
        },
        {
          "item": "fotfmail:letter_signed",
          "consume": true,
          "title": "Sign a letter for delivery"
        },
        {
          "talk": "villager",
          "profession": "minecraft:cartographer",
          "lines": [
            "A letter from Quill? About time. You'll do, runner."
          ],
          "title": "Hand it to a cartographer in another village"
        }
      ],
      "rewards": [
        {
          "item": "minecraft:bundle",
          "name": "Courier's Satchel"
