            "where": {
              "biomes": [
                "minecraft:jungle",
                "minecraft:bamboo_jungle"
              ]
            },
            "then": "kill",
            "lines": [
              "*A low growl in the undergrowth.*"
            ]
          },
          "title": "Take the tiger before it takes you"
        }
      ],
      "rewards": [
        {
          "item": "minecraft:arrow",
          "count": 32
        },
        {
          "item": "minecraft:gunpowder",
          "count": 16
        },
        {
          "skill": "range",
          "xp": 340
        }
      ],
      "icon": "minecraft:bow"
    },
