              "biomes": [
                "minecraft:swamp",
                "minecraft:mangrove_swamp"
              ]
            },
            "then": "kill",
            "lines": [
              "*The water ripples. Something huge coils.*"
            ]
          },
          "title": "Hunt the anaconda that sank the boat"
        },
        {
          "item": "alexsmobs:shed_snake_skin",
          "title": "Bring back its shed skin for the lodge"
        }
      ],
      "rewards": [
        {
          "item": "alexsmobs:shed_snake_skin"
        },
        {
          "skill": "range",
          "xp": 320
        }
      ],
      "icon": "alexsmobs:shed_snake_skin"
