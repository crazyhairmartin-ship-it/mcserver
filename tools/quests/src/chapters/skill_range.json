          "biome": "minecraft:savanna",
          "title": "Reach the savanna's long grass"
        },
        {
          "kill": "naturalist:lion",
          "count": 2,
          "title": "Bring down two lions of the pride for the lodge"
        },
        {
          "kill": "naturalist:rhino",
          "title": "Bring down a rhino for the lodge"
        },
        {
          "item": "naturalist:fur",
          "count": 2,
          "title": "Take their hides for the lodge wall"
        }
      ],
      "rewards": [
        {
          "item": "minecraft:spectral_arrow",
          "count": 32
        },
        {
          "item": "minecraft:arrow",
          "count": 64
        },
        {
          "skill": "range",
          "xp": 320
        }
      ],
      "icon": "naturalist:lion_spawn_egg"
    },
