    {
      "id": "sign_up",
      "title": "Entry Form",
      "text": [
        "Commodore Halloway runs the Anglers' Society from Reece. She'll sign you up for the season if you can land five fish with a plain rod."
      ],
      "tasks": [
        {
          "talk": "character",
          "character": "halloway",
          "lines": [
            "Another hopeful! Land five fish with a plain rod and you're in.",
            "The season's a long line. Bring patience, and tie good knots."
          ]
        },
        {
          "timed": {
            "seconds": 1200,
            "goal": {
              "stat": "minecraft:fish_caught",
              "count": 5
            },
            "lines": [
              "Five fish before the evening bell, plain rod. Off you go."
            ],
            "start": "Cast off"
          },
          "title": "Land five fish before the evening bell"
        }
      ],
      "rewards": [
        {
          "item": "aquaculture:worm",
