      "rewards": [
        {
          "item": "lilis_lucky_lures:fish_bag"
        },
        {
          "skill": "fish",
          "xp": 120
        }
      ],
      "icon": "lilis_lucky_lures:fish_trap"
    },
    {
      "id": "lighthouse_ledger",
      "title": "The Keeper's Ledger",
      "after": [
        "hooks_and_lines"
      ],
      "text": [
        "The season's record book is kept at a lighthouse on the coast. Take the keeper a fresh cod meal and read the records, including one of Silas's that looks forged."
      ],
      "tasks": [
        {
          "structure": "#lighthouses",
          "title": "Find a lighthouse"
        },
        {
          "item": "lilis_lucky_lures:cooked_cod_meal",
          "consume": true
        },
        {
          "search": {
            "at": {
              "structure": "#lighthouses"
            },
            "count": 1,
            "item": {
              "name": "Season's Record Book",
              "tooltip": "One of Silas's entries looks forged",
              "texture": "minecraft:item/book"
            },
            "found": "The keeper's record book, the season's catches in neat columns."
          },
          "title": "Find the record book"
        }
      ],
      "rewards": [
        {
          "skill": "fish",
          "xp": 150
        }
      ],
      "icon": "minecraft:lantern"
    },
    {
      "id": "beach_weigh_in",
      "title": "Beach Weigh-in",
      "after": [
        "lighthouse_ledger"
      ],
      "text": [
        "The coastal heat ends with a party at a beach hut: catch three tropical fish, grill them, and serve the judges."
      ],
      "tasks": [
        {
          "structure": "beachparty:beach_hut",
          "title": "Find the beach hut"
        },
        {
          "item": "lilis_lucky_lures:grilled_tropical_fish",
          "count": 3,
          "consume": true
        }
      ],
      "rewards": [
        {
          "item": "lilis_lucky_lures:fish_trophy_frame"
        },
        {
          "skill": "fish",
          "xp": 150
        }
      ],
      "icon": "lilis_lucky_lures:grilled_tropical_fish"
    },
    {
      "id": "dropped_rod",
      "title": "The Rod at the Bottom",
      "after": [
        "beach_weigh_in"
      ],
      "text": [
        "The society's heirloom rod went over the side of a boat in the deepest lake around. Silas swears it wasn't him. Dive down and get it back; the old diver's snorkel is yours afterwards."
      ],
      "tasks": [
        {
          "be": {
            "in_water": true,
            "below_y": 45
          },
          "title": "Dive to the bottom of the deepest lake"
        }
      ],
      "rewards": [
        {
          "item": "artifacts:snorkel"
        },
        {
          "skill": "fish",
          "xp": 200
        }
      ],
      "icon": "artifacts:snorkel",
      "signature": "artifacts:snorkel"
    }
